{
  "manifest_version": 3,
  "name": "Reasy",
  "version": "1.0.0",
  "description": "Selecione um texto na página e veja um resumo acessível em linguagem simples.",
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://chrome-extension-backend-tan.vercel.app/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"] }
  ],
  "action": { 
    "default_title": "Reasy",
    "default_popup": "popup.html"
  
  },
  "web_accessible_resources": [
    {
      "resources": ["popup.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
